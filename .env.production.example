DB_USERNAME=medclinic_app
DB_PASSWORD=
REMEMBER_ME_KEY=
SESSION_COOKIE_SECURE=true
APP_WEBSITE=https://clinic.example.com

MAIL_USERNAME=
MAIL_FROM=
MAIL_PASSWORD=
