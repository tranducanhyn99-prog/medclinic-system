# Chỉ dùng cho Docker Compose local/demo.
# Copy thành .env và tự điền secret trước khi chạy.
MSSQL_SA_PASSWORD=
REMEMBER_ME_KEY=

# Tùy chọn: để trống nếu không cần gửi email thật khi demo.
MAIL_USERNAME=
MAIL_PASSWORD=

# Security/runtime tuning cho local/demo. Production HTTPS nên để Secure=true.
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
