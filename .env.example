# Chỉ dùng cho Docker Compose local/demo.
# Copy thành .env và tự điền secret trước khi chạy.
MSSQL_SA_PASSWORD=
REMEMBER_ME_KEY=
SQLSERVER_HOST_PORT=14333
DEMO_EARLY_CLINICAL_PROCESSING=true

# Google OAuth Web application; callback http://localhost:8080/login/oauth2/code/google
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mặc định gửi email demo vào Mailpit. Xem docs/GMAIL_OTP_SETUP.md để gửi Gmail thật.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@medclinic.test
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=false

# Security/runtime tuning cho local/demo. Production HTTPS nên để Secure=true.
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_MAX=5
PAYMENT_CALLBACK_RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_STORE=jdbc
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_MS=250

# VietQR/MB Bank. Chỉ bật khi đã điền tài khoản thụ hưởng và secret >= 32 ký tự.
BANK_PAYMENT_ENABLED=false
BANK_PAYMENT_BANK_ID=970422
BANK_PAYMENT_BANK_NAME=MB Bank
BANK_PAYMENT_ACCOUNT_NO=
BANK_PAYMENT_ACCOUNT_NAME=
BANK_PAYMENT_QR_TEMPLATE=compact2
BANK_PAYMENT_CALLBACK_SECRET=
BANK_PAYMENT_EXPIRY_MINUTES=30
